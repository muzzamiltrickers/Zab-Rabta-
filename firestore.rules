rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'admin@zabrabta.org' ||
          request.auth.token.email == 'khuticheez42@gmail.com'
        ))
      );
    }

    // Users Collection: Private, no sensitive health data
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100
                    && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user');
      allow update: if isOwner(userId)
                    && request.resource.data.userId == resource.data.userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'userId', 'createdAt']);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Medicine Reminders: Strictly confidential, accessible only by owner
    match /medicineReminders/{reminderId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.medicineName is string
                    && request.resource.data.medicineName.size() <= 100
                    && request.resource.data.time is string;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.medicineName is string
                    && request.resource.data.medicineName.size() <= 100;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // HIV Centers: Public read, Admin write
    match /hivCenters/{centerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Districts: Public read, Admin write
    match /districts/{districtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Camps: Public read, Admin write
    match /camps/{campId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Awareness articles: Public read, Admin write
    match /awareness/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App Settings: Public read, Admin write
    match /appSettings/{settingDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
